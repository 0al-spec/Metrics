{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "intent_atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["user_story", "acceptance_criteria", "invariant", "architectural_decision"],
            "description": "Category of the intent atom"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the intent atom"
          }
        },
        "required": ["type", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["intent_atoms"],
  "additionalProperties": false
}
