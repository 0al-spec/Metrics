{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "functional_units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Brief name of the functional unit"
          },
          "description": {
            "type": "string",
            "description": "What the functional unit does"
          }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["functional_units"],
  "additionalProperties": false
}
